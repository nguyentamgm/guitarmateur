{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/theory/(.*)", "destination": "/theory" },
    { "source": "/ear/(.*)", "destination": "/ear" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
