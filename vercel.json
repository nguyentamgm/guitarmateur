{
  "cleanUrls": true,
  "redirects": [
    { "source": "/ear", "destination": "/ear-training", "permanent": true },
    { "source": "/ear/:path*", "destination": "/ear-training", "permanent": true }
  ],
  "rewrites": [
    { "source": "/theory/(.*)", "destination": "/theory" },
    { "source": "/ear-training", "destination": "/ear" },
    { "source": "/ear-training/(.*)", "destination": "/ear" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
